{
  "name": "tradelock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Risk-first trading discipline platform: Node API + vanilla ES-module web client",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
