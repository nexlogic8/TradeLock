    "seed": "node server/src/db/seed.js",
    "test": "node --test server/test/"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lightweight-charts": "^5.2.1",
    "ws": "^8.18.3"
  }
}
