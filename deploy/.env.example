# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain, without https:// (Caddy uses it for the HTTPS certificate)
DOMAIN=tradelock.in

NODE_ENV=production
PUBLIC_URL=https://tradelock.in

# Generate with:  openssl rand -base64 48
# Keep a copy somewhere safe: losing it makes stored broker tokens unreadable.
APP_SECRET=

SYNC_MS=2000
DEGRADED_AFTER_MS=30000

# Google sign-in (optional). Create an OAuth "Web application" client in Google Cloud Console.
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alert emails (optional). Alerts always show in the admin console and Notifications.
# Hostinger mailbox: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER=support@nexlogic.in
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Recipients (comma-separated); defaults to ADMIN_EMAILS
ALERT_EMAIL=
