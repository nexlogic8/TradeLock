# Copy to .env. Real environment variables take precedence.

# Required in production: long random string. Derives the key that encrypts broker tokens,
# so changing it makes stored tokens unreadable (users must reconnect).
APP_SECRET=

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public base URL, used in affiliate links.
PUBLIC_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

DB_PATH=data/tradelock.db

# Broker polling interval and when a stale sync counts as degraded.
SYNC_MS=2000
DEGRADED_AFTER_MS=30000
# Set to 0 to run the API without the background monitor (tests do this).
MONITOR=1

DHAN_BASE_URL=https://api.dhan.co/v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Demo broker only: make every exit fail, to see the failure path.
MOCK_EXIT_FAIL=0

# Google sign-in (optional). Create an OAuth "Web application" client in Google Cloud Console.
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
